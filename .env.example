# 基础配置
# SQLite 数据库文件路径，用于保存行情、股票名称、新闻缓存、洞察缓存等本地数据。
DB_PATH=data/sequoia_v2.db
# 首次同步历史行情的起始日期，格式为 YYYY-MM-DD。
START_DATE=2024-01-01
# 是否在运行策略前同步最新行情；false 表示只使用本地数据库已有数据。
SYNC_MARKET_DATA=true
# 行情数据源：auto 表示按 eastmoney -> sina 顺序自动尝试，也可固定为 eastmoney 或 sina。
MARKET_DATA_PROVIDER=auto
# 单次行情接口请求超时时间，单位为秒。
MARKET_DATA_TIMEOUT_SECONDS=10
# 同步股票列表时是否排除科创板、北交所、新三板、可转债、退市整理和 ST / *ST 等市场或标的。
SYNC_EXCLUDE_QUALIFIED_MARKETS=true

# 启动脚本配置
# start.py 常驻模式每天自动运行的时间，格式为 HH:MM:SS。
START_RUN_TIME=14:45:00
# GM 下单脚本使用的 Python 解释器路径；留空时优先使用 .venv310，找不到则使用当前 Python。
GM_PYTHON=

# 飞书推送
# 默认飞书机器人 Webhook；策略没有配置专属 Webhook 时会使用它。
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# MaVolumeStrategy 专属飞书 Webhook；需要专属机器人时取消注释并填写，未设置则回退到 FEISHU_WEBHOOK_URL。
# STRATEGY_WEBHOOK_MA_VOLUME=
# RPS 突破策略专属飞书 Webhook；环境变量后缀会转成小写 webhook_key。
# STRATEGY_WEBHOOK_RPS=
# Turtle 突破策略专属飞书 Webhook。
# STRATEGY_WEBHOOK_TURTLE=
# 新闻确认策略专属飞书 Webhook。
# STRATEGY_WEBHOOK_NEWS_CONFIRM=
# 高位紧旗形策略专属飞书 Webhook。
# STRATEGY_WEBHOOK_FLAG=
# 涨停洗盘策略专属飞书 Webhook。
# STRATEGY_WEBHOOK_SHAKEOUT=
# 上升趋势跌停策略专属飞书 Webhook。
# STRATEGY_WEBHOOK_LIMIT_DOWN=

# 新闻确认策略
# 新闻确认策略回看最近多少天的新闻。
NEWS_LOOKBACK_DAYS=7
# 新闻缓存保留天数，超过后会自动清理。
NEWS_CACHE_RETENTION_DAYS=90
# 新闻确认最低综合分，低于该分数的候选股不进入新闻确认结果。
NEWS_SCORE_THRESHOLD=20
# 高可信新闻综合分阈值，达到后 GM 买入股数可提升到 GM_NEWS_HIGH_CONFIDENCE_BUY_VOLUME。
NEWS_HIGH_CONFIDENCE_SCORE=80
# 推送中每只股票最多展示的命中新闻条数。
NEWS_MAX_ITEMS_PER_STOCK=2
# 是否对技术候选股启用 SearXNG 定向搜索以补充最新新闻。
NEWS_TARGETED_SEARCH_ENABLED=false
# SearXNG 服务地址，用于搜索候选股最新消息、业绩财报、行业政策等。
NEWS_SEARXNG_URL=
# SearXNG Basic Auth 用户名；未开启鉴权时留空。
NEWS_SEARXNG_USERNAME=
# SearXNG Basic Auth 密码；未开启鉴权时留空。
NEWS_SEARXNG_PASSWORD=
# 每个 SearXNG 查询最多读取的结果条数。
NEWS_TARGETED_SEARCH_LIMIT=3

# A 股增强洞察
# 是否启用 A 股增强洞察；开启后会在最终选股前刷新资金流、热度、题材和公告风险等外部数据。
A_SHARE_INSIGHT_ENABLED=false
# A 股增强洞察缓存时长，单位为小时；缓存未过期时优先复用本地数据。
A_SHARE_INSIGHT_CACHE_HOURS=8
# A 股增强洞察分数权重，用于最终综合评分。
A_SHARE_INSIGHT_SCORE_WEIGHT=1.0
# 是否启用硬风险剔除；true 表示命中重大风险的股票不进入最终买入池。
A_SHARE_INSIGHT_HARD_RISK_EXCLUDE=true
# A 股增强洞察外部接口请求超时时间，单位为秒。
A_SHARE_INSIGHT_REQUEST_TIMEOUT_SECONDS=10

# 策略参数
# 策略通知最多展示的股票数量；GM 实际信号数量仍由 GM_MAX_POSITIONS 控制。
STRATEGY_NOTIFY_MAX_SYMBOLS=30
# Turtle 策略突破窗口天数，用于计算前高突破。
TURTLE_BREAKOUT_DAYS=55
# Turtle 策略最低成交额要求，单位为元。
TURTLE_MIN_TURNOVER=200000000
# Turtle 策略最低单日涨幅要求，0.02 表示 2%。
TURTLE_MIN_DAILY_GAIN=0.02
# Turtle 策略最低量比要求，基于相对 20 日均量的放量倍数。
TURTLE_MIN_VOLUME_RATIO=1.2
# RPS 强度计算周期，单位为交易日。
RPS_PERIOD=120
# RPS 强度分位阈值，95 表示进入前 5% 强度区间。
RPS_THRESHOLD=95
# RPS 近高比例阈值，0.98 表示收盘价至少达到周期高点的 98%。
RPS_NEAR_HIGH_RATIO=0.98
# RPS 策略最低成交额要求，单位为元。
RPS_MIN_TURNOVER=200000000
# RPS 策略是否要求当日收阳且上涨。
RPS_REQUIRE_POSITIVE_DAY=true
# 所有策略汇总后最终最多选出的股票数量。
FINAL_SELECTION_MAX_SYMBOLS=5
# 最终选股最低综合分，低于该分数时允许当天没有入选股票。
FINAL_SELECTION_MIN_SCORE=60

# 微信 iLink
# 是否启用微信 iLink 推送。
WECHAT_ILINK_ENABLED=false
# 微信 iLink 目标用户 ID；需要目标用户先给机器人发消息后才能获得。
WECHAT_ILINK_TARGET_USER_ID=
# 微信 iLink 登录态和 contextToken 缓存文件路径。
WECHAT_ILINK_STATE_PATH=data/wechat_ilink_state.json
# 微信 iLink channel_version，通常保持默认值即可。
WECHAT_ILINK_CHANNEL_VERSION=1.0.0
# 微信 iLink 路由标签；没有特殊路由需求时留空。
WECHAT_ILINK_ROUTE_TAG=
# 扫码登录最长等待时间，单位为秒。
WECHAT_ILINK_LOGIN_TIMEOUT_SECONDS=180
# 距离上次互动超过多少小时后发送上下文保活提醒。
WECHAT_ILINK_CONTEXT_REMINDER_HOURS=12
# 是否启用上下文保活提醒。
WECHAT_ILINK_CONTEXT_KEEPALIVE_ENABLED=true
# 推送疑似 contextToken 失效时，是否先刷新上下文再重试一次。
WECHAT_ILINK_RETRY_ON_CONTEXT_ERROR=true

# 掘金 GM
# 是否启用掘金 GM 信号导出或下单流程。
GM_ENABLED=false
# 掘金 API Token，属于敏感信息，请只写入本地 .env，不要提交真实值。
GM_TOKEN=
# 掘金策略 ID，用于 gm_sim_strategy.py 在掘金环境运行。
GM_STRATEGY_ID=
# 掘金运行模式，当前默认 live 用于仿真或实时环境。
GM_MODE=live
# superQ 导出的掘金交易信号 JSON 文件路径。
GM_SIGNAL_PATH=data/gm_trade_signal.json
# 掘金账户资金、持仓、委托快照 JSON 文件路径。
GM_ACCOUNT_SNAPSHOT_PATH=data/gm_account_snapshot.json
# 下单后轮询账户快照的间隔时间，单位为秒。
GM_ACCOUNT_SNAPSHOT_POLL_SECONDS=10
# 提交 GM 交易后等待多少秒再获取最终账户、持仓和委托信息。
GM_FINAL_SNAPSHOT_WAIT_SECONDS=60
# 本地下单日志路径，用于记录每日下单次数并做风控。
GM_ORDER_LOG_PATH=data/gm_order_log.json
# 掘金仿真或实盘账户 ID。
GM_ACCOUNT_ID=
# 本机掘金终端服务地址；Docker 中通常使用 host.docker.internal:7001。
GM_SERV_ADDR=127.0.0.1:7001
# 每只股票计划买入金额，按金额下单逻辑使用。
GM_ORDER_CASH_PER_STOCK=10000
# 普通策略信号默认买入股数。
GM_BUY_VOLUME=100
# 策略信号叠加高可信新闻时的买入股数。
GM_NEWS_HIGH_CONFIDENCE_BUY_VOLUME=200
# 单只股票最大下单金额，0 表示不限制。
GM_MAX_ORDER_VALUE=0
# 最大持仓数量限制。
GM_MAX_POSITIONS=5
# 每日最大下单数量，0 表示不限制。
GM_DAILY_ORDER_LIMIT=0
# GM 交易黑名单，多个代码用英文逗号分隔，例如 SZSE.000007,SHSE.600900。
GM_BLACKLIST=
# gm_sim_strategy.py 在掘金环境中的定时下单时间，格式为 HH:MM:SS。
GM_TRADE_TIME=14:50:00
# 一键下单允许交易的开始时间，格式为 HH:MM:SS。
GM_TRADE_START_TIME=09:30:00
# 一键下单允许交易的结束时间，格式为 HH:MM:SS。
GM_TRADE_END_TIME=15:00:00
# 是否允许在非交易时间真实下单；false 更适合作为默认安全设置。
GM_ALLOW_NON_TRADE_TIME=false
# 是否只导出或打印交易计划而不真实下单；true 为演练模式，false 才会提交订单。
GM_DRY_RUN=true
