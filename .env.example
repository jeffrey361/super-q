# 基础配置
DB_PATH=data/sequoia_v2.db
START_DATE=2024-01-01
SYNC_MARKET_DATA=true
MARKET_DATA_PROVIDER=auto
MARKET_DATA_TIMEOUT_SECONDS=10
SYNC_EXCLUDE_QUALIFIED_MARKETS=true

# 飞书推送
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token

# 新闻确认策略
NEWS_LOOKBACK_DAYS=7
NEWS_CACHE_RETENTION_DAYS=90
NEWS_SCORE_THRESHOLD=20
NEWS_HIGH_CONFIDENCE_SCORE=80
NEWS_MAX_ITEMS_PER_STOCK=2
NEWS_TARGETED_SEARCH_ENABLED=false
NEWS_SEARXNG_URL=
NEWS_SEARXNG_USERNAME=
NEWS_SEARXNG_PASSWORD=
NEWS_TARGETED_SEARCH_LIMIT=3

# A 股增强洞察
A_SHARE_INSIGHT_ENABLED=false
A_SHARE_INSIGHT_CACHE_HOURS=8
A_SHARE_INSIGHT_SCORE_WEIGHT=1.0
A_SHARE_INSIGHT_HARD_RISK_EXCLUDE=true
A_SHARE_INSIGHT_REQUEST_TIMEOUT_SECONDS=10

# 策略参数
STRATEGY_NOTIFY_MAX_SYMBOLS=30
TURTLE_BREAKOUT_DAYS=55
TURTLE_MIN_TURNOVER=200000000
TURTLE_MIN_DAILY_GAIN=0.02
TURTLE_MIN_VOLUME_RATIO=1.2
RPS_PERIOD=120
RPS_THRESHOLD=95
RPS_NEAR_HIGH_RATIO=0.98
RPS_MIN_TURNOVER=200000000
RPS_REQUIRE_POSITIVE_DAY=true
FINAL_SELECTION_MAX_SYMBOLS=5
FINAL_SELECTION_MIN_SCORE=60

# 微信 iLink
WECHAT_ILINK_ENABLED=false
WECHAT_ILINK_TARGET_USER_ID=
WECHAT_ILINK_STATE_PATH=data/wechat_ilink_state.json
WECHAT_ILINK_CHANNEL_VERSION=1.0.0
WECHAT_ILINK_ROUTE_TAG=
WECHAT_ILINK_LOGIN_TIMEOUT_SECONDS=180
WECHAT_ILINK_CONTEXT_REMINDER_HOURS=12
WECHAT_ILINK_CONTEXT_KEEPALIVE_ENABLED=true
WECHAT_ILINK_RETRY_ON_CONTEXT_ERROR=true

# 掘金 GM
GM_ENABLED=false
GM_TOKEN=
GM_STRATEGY_ID=
GM_MODE=live
GM_SIGNAL_PATH=data/gm_trade_signal.json
GM_ACCOUNT_SNAPSHOT_PATH=data/gm_account_snapshot.json
GM_ACCOUNT_SNAPSHOT_POLL_SECONDS=10
GM_FINAL_SNAPSHOT_WAIT_SECONDS=60
GM_ORDER_LOG_PATH=data/gm_order_log.json
GM_ACCOUNT_ID=
GM_SERV_ADDR=127.0.0.1:7001
GM_ORDER_CASH_PER_STOCK=10000
GM_BUY_VOLUME=100
GM_NEWS_HIGH_CONFIDENCE_BUY_VOLUME=200
GM_MAX_ORDER_VALUE=0
GM_MAX_POSITIONS=5
GM_DAILY_ORDER_LIMIT=0
GM_BLACKLIST=
GM_TRADE_TIME=14:50:00
GM_TRADE_START_TIME=09:30:00
GM_TRADE_END_TIME=15:00:00
GM_ALLOW_NON_TRADE_TIME=false
GM_DRY_RUN=true
