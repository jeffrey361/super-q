# 基础配置
# SQLite 数据库路径，保存行情、股票名称、新闻缓存等本地数据。
DB_PATH=data/sequoia_v2.db
# 行情同步起始日期，首次拉取历史 K 线时使用。
START_DATE=2024-01-01
# 是否同步行情；false 时即使交易日也跳过网络拉取，只使用本地数据库跑策略。
SYNC_MARKET_DATA=true
# 新闻确认策略回看最近多少天的新闻。
NEWS_LOOKBACK_DAYS=7
# 新闻缓存保留天数，超过后自动清理。
NEWS_CACHE_RETENTION_DAYS=90
# 新闻确认最低综合分，低于该分数不入选。
NEWS_SCORE_THRESHOLD=20
# 新闻高可信综合分，达到后掘金买入股数提高到 GM_NEWS_HIGH_CONFIDENCE_BUY_VOLUME。
NEWS_HIGH_CONFIDENCE_SCORE=80
# 推送里每只股票最多展示几条命中新闻。
NEWS_MAX_ITEMS_PER_STOCK=2

# 飞书推送
# 默认飞书机器人 Webhook，策略未配置专属 Webhook 时使用。
FEISHU_WEBHOOK_URL=https://www.feishu.cn/flow/api/trigger-webhook/b5fa86ba85adc349f5763834a113392d
# MaVolumeStrategy 专属飞书 Webhook。
STRATEGY_WEBHOOK_MA_VOLUME=https://www.feishu.cn/flow/api/trigger-webhook/b5fa86ba85adc349f5763834a113392d
# 突破类策略专属飞书 Webhook。
STRATEGY_WEBHOOK_BREAKOUT=https://www.feishu.cn/flow/api/trigger-webhook/b5fa86ba85adc349f5763834a113392d

# 微信 iLink 推送
# 是否启用微信 iLink 推送，true 开启，false 关闭。
WECHAT_ILINK_ENABLED=true
# 微信 iLink 目标用户 ID，需要用户先给 bot 发消息后缓存上下文。
WECHAT_ILINK_TARGET_USER_ID=o9cq80zuqWthp3Hs2uFolVHKLP8s@im.wechat
# 微信 iLink 登录态和 contextToken 缓存文件路径。
WECHAT_ILINK_STATE_PATH=data/wechat_ilink_state.json
# 微信 iLink channel_version，通常保持 1.0.0。
WECHAT_ILINK_CHANNEL_VERSION=1.0.0
# 微信 iLink 路由标签，通常留空。
WECHAT_ILINK_ROUTE_TAG=
# 扫码登录最长等待秒数。
WECHAT_ILINK_LOGIN_TIMEOUT_SECONDS=180
# 是否启用上下文保活提醒。
WECHAT_ILINK_CONTEXT_KEEPALIVE_ENABLED=true
# 距离上次互动超过多少小时后发送保活提醒。
WECHAT_ILINK_CONTEXT_REMINDER_HOURS=6
# 推送疑似 contextToken 失效时，是否 getUpdates 后重试一次。
WECHAT_ILINK_RETRY_ON_CONTEXT_ERROR=true

# 掘金 GM 信号/仿真交易
# 是否导出掘金 GM 交易信号。
GM_ENABLED=true
# 掘金 API Token，敏感信息，不要提交到代码仓库。
GM_TOKEN=247db229b72c870d4c71160d580f812e024c61a3
# 掘金策略 ID，用于 gm_sim_strategy.py 在掘金环境运行。
GM_STRATEGY_ID=你的策略ID
# 掘金仿真/实盘账户 ID。
GM_ACCOUNT_ID=67b148cf-405a-11f1-afbe-00163e022aa6
# 本机掘金终端服务地址；Docker 中通常用 host.docker.internal:7001。
GM_SERV_ADDR=127.0.0.1:7001
# 掘金运行模式，当前默认 live 用于仿真/实时环境。
GM_MODE=live
# superQ 导出的掘金交易信号 JSON 路径。
GM_SIGNAL_PATH=data/gm_trade_signal.json
# 掘金账户资金和持仓快照 JSON 路径。
GM_ACCOUNT_SNAPSHOT_PATH=data/gm_account_snapshot.json
# 下单后轮询账户快照的秒数，用于等待 GM 成交/持仓查询刷新。
GM_ACCOUNT_SNAPSHOT_POLL_SECONDS=10
# 提交掘金交易后等待多少秒再获取最终账户/持仓/委托信息。
GM_FINAL_SNAPSHOT_WAIT_SECONDS=60
# 一键下单脚本的本地下单日志路径，用于每日下单次数风控。
GM_ORDER_LOG_PATH=data/gm_order_log.json
# 每只股票计划买入金额。
GM_ORDER_CASH_PER_STOCK=10000
# 普通策略买入股数。
GM_BUY_VOLUME=100
# 策略叠加高可信新闻时买入股数。
GM_NEWS_HIGH_CONFIDENCE_BUY_VOLUME=150
# 单票最大下单金额，0 表示不限制。
GM_MAX_ORDER_VALUE=0
# 最大持仓数量限制。
GM_MAX_POSITIONS=5
# 每日最大下单数量，0 表示不限制。
GM_DAILY_ORDER_LIMIT=0
# 交易黑名单，多个 GM 代码用英文逗号分隔，例如 SZSE.000007,SHSE.600900。
GM_BLACKLIST=
# gm_sim_strategy.py 在掘金环境中的定时下单时间。
GM_TRADE_TIME=14:50:00
# 一键下单允许交易的开始时间。
GM_TRADE_START_TIME=09:30:00
# 一键下单允许交易的结束时间。
GM_TRADE_END_TIME=15:00:00
# 是否允许非交易时间真实下单，false 更安全。
GM_ALLOW_NON_TRADE_TIME=false
# 是否只导出/打印计划不真实下单，true 为演练，false 为提交仿真订单。
GM_DRY_RUN=false
